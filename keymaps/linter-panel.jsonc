{
  // Reveal the panel, and hand focus back to the editor on a second press. A
  // bare alt-<letter> is the tier for revealing a surface; nothing else claims
  // one.
  "lumine-workspace": {
    "alt-l": "linter-panel:toggle-focus"
  },
  // Keyboard navigation while the panel itself is focused.
  ".linter-panel": {
    "up": "core:move-up",
    "down": "core:move-down",
    "enter": "core:confirm",
    "escape": "core:cancel"
  }
}
